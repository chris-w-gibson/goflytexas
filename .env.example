# --- Required ---

# Postgres (Railway will provide DATABASE_URL automatically when you attach a Postgres plugin)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Resend transactional email (https://resend.com — create API key, verify goflytexas.com domain)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Site URL used in email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://goflytexas.com

# Shared secret that the weekly-followup cron job uses to authenticate
CRON_SECRET=generate-a-long-random-string

# --- Optional ---

# Gates /admin/* with ?key=$ADMIN_TOKEN (cookie persists 30 days). If unset, admin is OPEN — banner is shown.
# REQUIRED before exposing this site publicly.
ADMIN_TOKEN=generate-a-long-random-string

# Extra recipients for the "new lead" alert, comma-separated (e.g. Jim's personal
# inbox). ADMIN_EMAIL always gets it too.
LEAD_NOTIFY_EMAILS=

# Follow-up drip: days after the lead came in for step 1, 2, 3… (default 7,14,21).
# The cron at /api/cron/weekly-followup should run DAILY; each step sends once.
FOLLOWUP_DAYS=

# --- AI phone agent (answers MISSED calls forwarded from (940) 905-3090 via Vapi) ---
# Vapi custom-LLM credential: Bearer / x-vapi-secret on POST /api/voice/llm/chat/completions
VOICE_LLM_SECRET=
# Vapi server-URL secret: x-vapi-secret (or ?key=) on POST /api/voice/webhook
VOICE_WEBHOOK_SECRET=
# Vapi private API key (dashboard → API keys). Used only server-side to mint a fresh
# presigned recording URL when someone clicks "Listen to the recording".
VAPI_API_KEY=
# Optional model override; defaults to CHAT_MODEL, then claude-haiku-4-5
VOICE_MODEL=
# Assistant turns per call before it wraps up (default 16)
VOICE_MAX_TURNS=
# Hard cap on AI-handled calls per UTC day (default 60)
VOICE_DAILY_CALL_LIMIT=
# 1 = also create a lead + email for hang-ups with no message (default 0 = log only)
VOICE_NOTIFY_NO_MESSAGE=

# --- Phase 2: every call rings the team first via Twilio, the AI answers the rest ---
VOICE_ROUTING_MODE=ai_only          # humans_first | ai_only | passthrough. ai_only = Phase 1 behaviour; passthrough = plain forward, no AI/recording
VOICE_RING_TARGETS=                 # "+18175551234:Jim,+18175555678:Ann" — cells to ring. Never the forwarded line itself.
VOICE_PUBLISHED_NUMBER=+19409053090 # the number Jim forwards (loop guard)
VOICE_TWILIO_NUMBER=+19402423072    # our Twilio switchboard number
VOICE_AI_NUMBER=+19402917613        # Vapi-provisioned number the AI assistant answers on (PSTN hand-off)
VOICE_AI_SIP_URI=                   # optional: sip:… to hand off over SIP instead
VOICE_RING_TIMEOUT=20               # seconds the humans' phones ring
VOICE_WHISPER_TIMEOUT=4             # seconds to press 1 after the whisper
VOICE_BUSINESS_HOURS=08:00-17:00    # outside → straight to the AI
VOICE_TZ=America/Chicago
VOICE_WHISPER_VOICE=Polly.Matthew-Neural
VOICE_PUBLIC_BASE_URL=              # exact host Twilio is configured with (signature check); defaults to NEXT_PUBLIC_SITE_URL
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                  # signs every Twilio webhook + Basic auth for recording downloads
DEEPGRAM_API_KEY=                   # dual-channel transcription of answered calls
DEEPGRAM_MODEL=nova-3

# Sender + admin notification addresses (defaults shown)
EMAIL_FROM=GoFlyTexas <info@goflytexas.com>
ADMIN_EMAIL=info@goflytexas.com
